{
  "name": "@short-it/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run src",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "bdd": "node scripts/run-bdd.mjs default",
    "bdd:publication-guardrails": "node scripts/run-bdd.mjs publication-guardrails",
    "bdd:rate-limit": "node scripts/run-bdd.mjs rate-limit",
    "coverage": "vitest run --coverage src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@prisma/client": "7.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "@short-it/contracts": "workspace:*",
    "better-auth": "1.7.1",
    "express": "5.2.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "testcontainers": "12.1.0",
    "vitest": "4.1.11"
  }
}
