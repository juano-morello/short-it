:8080 {
  @dashboard host app.{$APP_BASE_DOMAIN:localhost}

  handle @dashboard {
    handle /api/* {
      request_body {
        max_size 64KiB
      }
      reverse_proxy api:3000 {
        header_up X-Real-IP {remote_host}
      }
    }

    handle {
      reverse_proxy web:5173
    }
  }

  @public-link {
    host *.{$APP_BASE_DOMAIN:localhost}
    method GET HEAD
    path_regexp published_link ^/c[a-z0-9]{24}$
  }

  # Tenant hosts expose only public CUID redirects. Their host is retained for
  # the API's independently validated tenant lookup.
  handle @public-link {
    reverse_proxy api:3000
  }

  handle {
    respond "Not found" 404
  }
}
